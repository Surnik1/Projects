@bot.message_handler(content_types=["text"])
def convert(message):
    try:
        txt = message.text.upper().split()
        if len(txt) == 2:
            amount = 1
            base, target = txt
        elif len(txt) == 3:
            amount = float(txt[0])
            base, target = txt[1], txt[2]
        else:
            a = 0 / 0
        rate = get_exchange(base, target)
        if not rate:
            a = int("kdd")
        result = amount * rate
        bot.send_message(message.chat.id, f"{amount} {base} = {result:.3f} {target}")
    except ZeroDivisionError:
        bot.send_message(
            message.chat.id, "You done something wrong.\nExample:\n100 USD KZT\nUSD KZT"
        )
    except ValueError:
        bot.send_message(
            message.chat.id,
            "You done something wrong.\nYour target currency arent available",
        )


