import telebot
import requests
from telebot import types

tg_bot_key = "token from bot father    "
exchanger_key = "api-token"
bot = telebot.TeleBot(tg_bot_key)


def get_exchange(base, target):
    url = f"https://v6.exchangerate-api.com/v6/03e0c81500adaac97a59e416/latest/{base}"
    response = requests.get(url)
    data = response.json()
    if response.status_code == 200 and target in data["conversion_rates"]:
        return data["conversion_rates"][target]
    else:
        return None


